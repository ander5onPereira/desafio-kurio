# Copie para .env.local para sobrescrever localmente.
# Liga a camada de mocks (MSW). Em produção real ficaria "false" e o front falaria com o backend.
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks (também aceito via ?scenario=<id> na URL). Ver docs/MOCKS.md.
VITE_MOCK_SCENARIO=default
# Base da API REST (relativa: o MSW intercepta no navegador).
VITE_API_URL=/api
